---
// Carte d'un projet dans la grille de la page Projets.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const { title, summary, techs, cover, coverAlt, repo } = project.data;
---

<article class="card glass" id={project.id} data-reveal style={`--delay:${delay}ms`}>
  <div class="media">
    <Image src={cover} alt={coverAlt} width={640} />
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <ul class="techs">
      {techs.map((t) => <li class="chip">{t}</li>)}
    </ul>
    {
      repo && (
        <a class="repo" href={repo} target="_blank" rel="noopener">
          Voir le code ↗
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .card:hover {
    transform: translateY(-8px);
    border-color: rgb(255 122 61 / 0.45);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }
  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #fff;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .media :global(img) {
    transform: scale(1.07);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px 24px;
    flex: 1;
  }
  h3 {
    font-size: 1.3rem;
  }
  p {
    color: var(--muted);
  }
  .techs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin-top: auto;
  }
  .repo {
    color: var(--orange);
    font-weight: 600;
    text-decoration: none;
  }
  .repo:hover {
    text-decoration: underline;
  }
</style>
