---
// Barre de navigation « verre dépoli », collée en haut de l'écran.
// L'onglet actif est calculé à partir de l'URL courante (Astro.url) :
// https://docs.astro.build/en/reference/api-reference/#url
import { Image } from "astro:assets";
import triangle from "../assets/triangle.svg";

const links = [
  { href: "/", label: "Accueil" },
  { href: "/about", label: "À propos" },
  { href: "/skills", label: "Compétences" },
  { href: "/projects", label: "Projets" },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const current = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";
---

<header transition:persist>
  <nav class="glass">
    <a href={base + "/"} class="brand" aria-label="Accueil">
      <Image src={triangle} alt="" width={22} height={21} class="logo" />
      <span>Thibaut<span class="dot">.</span></span>
    </a>
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={base + href} aria-current={current === href ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Comme la nav est conservée entre les pages (transition:persist),
  // on remet à jour l'onglet actif après chaque navigation.
  document.addEventListener("astro:page-load", () => {
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    const path = location.pathname.replace(base, "").replace(/\/$/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>("header ul a").forEach((a) => {
      const href = a.getAttribute("href")!.replace(base, "") || "/";
      if (href === path) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  });
</script>

<style>
  header {
    position: sticky;
    top: 12px;
    z-index: 50;
    width: min(1100px, 100% - 24px);
    margin: 12px auto 0;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 18px;
    border-radius: 999px;
    background: rgb(15 15 22 / 0.65);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.35);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .logo {
    filter: invert(1);
    transition: transform 0.6s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .brand:hover .logo {
    transform: rotate(120deg);
  }
  .dot {
    color: var(--pink);
  }
  ul {
    display: flex;
    gap: 2px;
    list-style: none;
  }
  ul a {
    position: relative;
    display: block;
    padding: 8px 16px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      color 0.2s,
      background 0.2s;
  }
  ul a:hover {
    color: var(--text);
    background: var(--surface-hover);
  }
  ul a[aria-current="page"] {
    color: #fff;
    background: var(--gradient);
    box-shadow: 0 4px 18px rgb(255 77 141 / 0.35);
  }
  @media (max-width: 680px) {
    nav {
      padding: 6px;
    }
    .brand span {
      display: none;
    }
    .brand {
      padding-left: 8px;
    }
    ul a {
      padding: 7px 10px;
      font-size: 0.8rem;
    }
  }
  @media (max-width: 380px) {
    ul a {
      padding: 7px 7px;
      font-size: 0.74rem;
    }
  }
</style>
